{
  "name": "costlens",
  "version": "0.1.0",
  "description": "A pi extension that books the real dollar cost of every assistant message to a feature (git branch), with a local dashboard.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:watch": "node --import tsx --test --watch test/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.3"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "bun-types": "^1.3.14",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "pi": {
    "extensions": [
      "./extension/index.ts"
    ]
  }
}
