{
  "name": "opencode-costlens",
  "version": "0.1.0",
  "description": "Costlens plugin for opencode — books the dollar cost of every assistant message to a feature (git branch), with the same dashboard as pi-costlens.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "author": "Leo Gutierrez <slay22@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/slay22/pi-costlens.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "ai",
    "cost-tracking",
    "llm",
    "developer-tools",
    "dashboard"
  ],
  "exports": {
    "./server": "./src/server.ts",
    "./tui": "./src/tui.tsx",
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "bun test src/server.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "echo \"opencode-costlens: no build (TypeScript loaded by Bun)\"",
    "clean": "rm -rf node_modules .tsbuildinfo"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "dependencies": {
    "@costlens/core": "workspace:^"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "*",
    "@types/node": "^22.7.0",
    "bun-types": "^1.3.14",
    "solid-js": "^1.9.0",
    "typescript": "^5.6.0"
  }
}
